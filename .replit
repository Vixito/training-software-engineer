modules = ["python-3.15.2"]

[nix]
packages = ["libxcrypt"]

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "python -m pip install -r requirements.txt"]

[deployment.run]
args = ["sh", "-c", "python -m uvicorn main:app --host 0.0.0.0 --port 8000"]

[deployment.run.env]
file = "main.py"

[[ports]]
localPort = 8000
externalPort = 80
exposeLocalhost = true
