entrypoint = "main.py"
modules = ["python-3.15.2"]

[nix]
packages = ["libxcrypt"]

[run]
args = ["sh", "-c", "python3 -m uvicorn main:app --host 0.0.0.0 --port 8000"]

[deployment]
deploymentTarget = "cloudrun"
build = "python3 -m pip install -r requirements.txt"
run = "python3 -m uvicorn main:app --host 0.0.0.0 --port 8000"

[[ports]]
localPort = 8000
externalPort = 80
exposeLocalhost = true