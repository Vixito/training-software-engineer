modules = ["python-3.11"]

[nix]
packages = ["libxcrypt"]

[deployment]
deploymentTarget = "cloudrun"

[deployment.run]
args = ["sh", "-c", "/nix/store/s4ckxp77ljlikarkka88ba7qr5mlka97-python3-wrapper/bin/python3 $file"]

[deployment.run.env]
file = "main.py"

[[ports]]
localPort = 8000
externalPort = 80
exposeLocalhost = true
