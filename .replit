entrypoint = "main.py"
modules = ["python-3.12"]

[nix]
packages = ["libxcrypt"]

[packager]
language = "python3"

[packager.features]
enabledForHosting = true

[run]
args = ["sh", "-c", "UV_PROJECT_ENVIRONMENT=.venv uv sync && .venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000"]

[deployment]
deploymentTarget = "cloudrun"
run = "sh -c 'UV_PROJECT_ENVIRONMENT=.venv uv sync && .venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000'"

[env]
UV_PROJECT_ENVIRONMENT = ".venv"

[[ports]]
localPort = 8000
externalPort = 80
